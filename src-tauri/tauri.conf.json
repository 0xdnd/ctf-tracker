{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZeroBox",
  "version": "2.5.6",
  "identifier": "com.zerobox.tacticaltracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeroBox — Offline CTF Tracker & Exam Simulator",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "ZeroBox — Offline CTF Tracker & Exam Simulator",
    "longDescription": "Offline-first CTF tracker and 7-track certification exam simulator for Hack The Box, TryHackMe, Proving Grounds and VulnHub, with attack graph, methodology checklist, notes vault and report studio.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/0xdnd/ctf-tracker/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0RUVGQUY2NUQ4RjgwNzMKUldSemdJOWQ5dnJ1RktWS29vSmhDeFB6dFErc0FKc3VWTnBJTENla2tNYmd6eTBtaGVBSytLUFkK"
    }
  }
}