{
  "name": "zerobox",
  "productName": "ZeroBox",
  "description": "ZeroBox: free, offline CTF tracker for Hack The Box & TryHackMe. Track capture the flag machines, loot, notes and OSCP/CPTS exam prep in one dashboard.",
  "keywords": [
    "ctf",
    "ctf-tracker",
    "capture-the-flag",
    "ctf-tools",
    "hackthebox",
    "htb",
    "tryhackme",
    "thm",
    "oscp",
    "cpts",
    "crto",
    "pentesting",
    "penetration-testing",
    "cybersecurity",
    "infosec",
    "offensive-security",
    "reverse-shell",
    "cheatsheet",
    "writeups",
    "kanban"
  ],
  "private": true,
  "version": "2.4.1",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Daniel Dayan <0xdnd>",
  "homepage": "https://ctftracker.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xdnd/ctf-tracker.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --mode tauri",
    "writeups:check": "node scripts/check-writeups.cjs",
    "writeups:manifest": "node scripts/gen-own-writeups.cjs",
    "writeups:redact": "node scripts/redact-notes.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "python scripts/run_webapp_tests.py",
    "test:e2e:pw": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:a11y:static": "playwright test -c playwright.static.config.ts",
    "check:html": "npx --yes html-validate@11.16.2 -c .htmlvalidate.json \"dist/**/index.html\"",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 664",
    "knip": "knip",
    "notes:todo": "node scripts/notes-todo.cjs",
    "index-notes": "node scripts/index-cpts-notes.cjs",
    "submit:indexnow": "node scripts/submit-indexnow.cjs",
    "build": "node scripts/gen-own-writeups.cjs && tsc && vite build && node scripts/postbuild.cjs && node scripts/gen-site-tokens.cjs && node scripts/prerender.cjs && node scripts/gen-content-pages.cjs && node scripts/apply-csp.cjs",
    "build:tauri": "node scripts/gen-own-writeups.cjs && tsc && vite build --mode tauri && node scripts/postbuild.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "share": "npx --yes localtunnel@2.0.2 --port 3000",
    "preview": "vite preview",
    "preview:built": "npm run build && vite preview --port 3000 --strictPort",
    "lighthouse:a11y": "node scripts/lighthouse_a11y.mjs",
    "check:active": "node scripts/check-active-machines.mjs",
    "stats:catalog": "node scripts/catalog-stats.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^11.18.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lighthouse": "^13.5.0",
    "markdown-it": "^14.3.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
