{
  "name": "zerobox",
  "productName": "ZeroBox",
  "description": "ZeroBox: free, offline CTF tracker for Hack The Box & TryHackMe. Track capture the flag machines, loot, notes and OSCP/CPTS exam prep in one dashboard.",
  "keywords": [
    "ctf",
    "ctf-tracker",
    "capture-the-flag",
    "ctf-tools",
    "hackthebox",
    "htb",
    "tryhackme",
    "thm",
    "oscp",
    "cpts",
    "crto",
    "pentesting",
    "penetration-testing",
    "cybersecurity",
    "infosec",
    "offensive-security",
    "reverse-shell",
    "cheatsheet",
    "writeups",
    "kanban"
  ],
  "private": true,
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Daniel Dayan <0xdnd>",
  "homepage": "https://ctftracker.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xdnd/ctf-tracker.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --mode tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python scripts/run_webapp_tests.py",
    "test:e2e:pw": "playwright test",
    "lint": "eslint .",
    "index-notes": "node scripts/index-cpts-notes.cjs",
    "build": "tsc && vite build && node scripts/postbuild.cjs && node scripts/prerender.cjs && node scripts/gen-content-pages.cjs",
    "build:tauri": "tsc && vite build --mode tauri && node scripts/postbuild.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "share": "npx --yes localtunnel@2.0.2 --port 3000",
    "preview": "vite preview",
    "lighthouse:a11y": "node scripts/lighthouse_a11y.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "framer-motion": "^11.18.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.1",
    "simple-icons": "^16.29.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.1.0",
    "vitest": "^5.0.0"
  }
}
